# ---- WorkBuddy 本地工作区数据（记忆、会话、缓存，不参与版本管理）----
.workbuddy/
.workbuddy
**/.workbuddy/

# ---- Go 编译产物与调试文件 ----
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
sc

# ---- 性能分析输出（go tool trace / pprof）----
trace.out
*.prof
cpu.out
mem.out
block.out
mutex.out
*.pprof

# ---- 编辑器本地配置（保留 launch.json 供共享调试配置）----
.vscode/*
!.vscode/launch.json
.idea/
*.swp

# ---- 系统文件 ----
.DS_Store
Thumbs.db
desktop.ini
